# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://usuario:clave@localhost:5432/pos_voz
# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=America/Guayaquil
LOGIN_MAX_ATTEMPTS=10
SERVE_FRONTEND=false
# Contraseñas de los usuarios demo (solo para db:init:demo)
DEMO_ADMIN_PASSWORD=
DEMO_VENDEDOR_PASSWORD=
# Hosting (Render): ver DEPLOY_RENDER.md
TRUST_PROXY=0
DATABASE_SSL=false
ADMIN_EMAIL=admin@posvoz.com
ADMIN_PASSWORD=
VENDEDOR_EMAIL=vendedor@posvoz.com
VENDEDOR_PASSWORD=
RESET_PASSWORDS=false
